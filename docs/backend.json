
{
  "entities": {
    "Student": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Student",
      "type": "object",
      "description": "Represents a student in the attendance system.",
      "properties": {
        "registerNumber": {
          "type": "string",
          "description": "Unique identifier for the student (min 6 chars).",
          "format": "string"
        },
        "name": {
          "type": "string"
        },
        "fatherName": {
          "type": "string"
        },
        "motherName": {
          "type": "string"
        },
        "department": {
          "type": "string",
          "enum": ["cs", "ce", "me", "ee", "mce", "ec"]
        },
        "semester": {
          "type": "number",
          "description": "Current semester (1-6)."
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "contact": {
          "type": "string"
        },
        "uid": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "registerNumber",
        "name",
        "department",
        "semester",
        "email",
        "createdAt"
      ]
    },
    "Attendance": {
      "title": "Attendance",
      "type": "object",
      "properties": {
        "studentRegister": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["present", "absent"] },
        "markedBy": { "type": "string" },
        "method": { "type": "string", "enum": ["manual"] },
        "subject": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "department": { "type": "string" },
        "studentUid": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["studentRegister", "date", "status", "markedBy", "method", "timestamp", "department", "studentUid"]
    },
    "Teacher": {
      "title": "Teacher",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "department": { "type": "string" },
        "position": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "subjects": { "type": "object" }
      },
      "required": ["teacherId", "name", "email", "department", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      { "path": "/students/{registerNumber}", "definition": { "entityName": "Student" } },
      { "path": "/attendance/{attendanceId}", "definition": { "entityName": "Attendance" } },
      { "path": "/teachers/{email}", "definition": { "entityName": "Teacher" } },
      { "path": "/institution/profile", "definition": { "entityName": "InstitutionProfile" } }
    ]
  }
}
