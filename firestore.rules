
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ======== Helper Functions ========
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "apdd46@gmail.com";
    }

    function isTeacher() {
      // Document IDs are normalized emails (lowercase)
      let email = request.auth.token.email.lower();
      return isSignedIn() && exists(/databases/$(database)/documents/teachers/$(email));
    }
    
    function getTeacherDepartment() {
        let email = request.auth.token.email.lower();
        return get(/databases/$(database)/documents/teachers/$(email)).data.department;
    }

    // ======== Path Rules ========
    
    // Publicly readable institution profile
    match /institution/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Teachers collection
    match /teachers/{email} {
      // Normalize email for comparison
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.email.lower() == email.lower());
      allow write: if isAdmin();
    }
    match /teachers {
        allow list: if isAdmin();
    }

    // --- Students ---
    match /students/{studentId} {
      allow read: if isAdmin() || 
                   (isTeacher() && resource.data.department == getTeacherDepartment()) ||
                   (isSignedIn() && resource.data.uid == request.auth.uid);

      allow write: if isAdmin();
    }


    // --- Attendance ---
    match /attendance/{attendanceId} {
      // Define who can read attendance data (get and list)
      allow read: if isAdmin() ||
                   (isTeacher() && resource.data.department == getTeacherDepartment()) ||
                   (isSignedIn() && resource.data.studentUid == request.auth.uid);

      // Create/Update checks
      allow create: if isAdmin() || 
                       (isTeacher() && request.resource.data.department == getTeacherDepartment());

      allow update: if isAdmin() ||
                       (isTeacher() && request.resource.data.department == getTeacherDepartment());
      
      allow delete: if isAdmin();
    }
    
    // Default deny all other paths.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
