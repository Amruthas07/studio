
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ======== Helper Functions ========
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email != null && 
             request.auth.token.email.lower() == "apdd46@gmail.com";
    }

    function isTeacher() {
      return isSignedIn() && 
             request.auth.token.email != null && 
             exists(/databases/$(database)/documents/teachers/$(request.auth.token.email.lower()));
    }
    
    function getTeacherDepartment() {
        return get(/databases/$(database)/documents/teachers/$(request.auth.token.email.lower())).data.department;
    }

    // ======== Path Rules ========
    
    match /institution/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teachers/{email} {
      allow read, list: if isAdmin() || (isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email.lower());
      // Admins have full management control
      allow create, update, delete: if isAdmin();
    }
    
    match /teachers {
        allow list: if isAdmin();
    }

    match /students/{studentId} {
      allow read, list: if isAdmin() || 
                   (isTeacher() && resource.data.department == getTeacherDepartment()) ||
                   (isSignedIn() && resource.data.uid == request.auth.uid);

      // Enforce age validation only on creation to prevent blocking legacy updates/promotions
      allow create: if isAdmin() && request.resource.data.dateOfBirth <= request.time - duration.value(5844, 'd');
      
      // Admins can update or delete existing students
      allow update, delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read, list: if isAdmin() ||
                   (isTeacher() && resource.data.department == getTeacherDepartment()) ||
                   (isSignedIn() && resource.data.studentUid == request.auth.uid);

      allow create: if isAdmin() || 
                       (isTeacher() && request.resource.data.department == getTeacherDepartment());

      allow update: if isAdmin() ||
                       (isTeacher() && request.resource.data.department == getTeacherDepartment());
      
      allow delete: if isAdmin();
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
